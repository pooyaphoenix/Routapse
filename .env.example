# ===== Routapse configuration =====
# Copy to .env. Docker Compose reads it for build options and passes it to the containers.

# --- build options (Docker only) ---
INSTALL_LAYA=0                      # 1 = install the `laya` package into the router image
# Use these if PyPI, npm or Docker Hub are slow or blocked on your network:
# PIP_INDEX_URL=https://your-pypi-mirror/simple
# NPM_REGISTRY=https://your-npm-mirror
# PYTHON_IMAGE=python:3.12-slim
# NODE_IMAGE=node:20-alpine

# --- shared ---
STORE_URL=redis://redis:6379/0      # or file:///data/store.json (single replica only)
ROUTER_URL=http://router:8001
ADMIN_TOKEN=change-me               # GUI / admin API bearer token (empty = no auth, local use only)
GATEWAY_API_KEY=                    # optional: require this key on /v1/*
CORS_ORIGINS=*

# --- local Ollama (auto-discovered in Connections) ---
# Containers reach the host through host.docker.internal; start Ollama with: OLLAMA_HOST=0.0.0.0 ollama serve
# Without Docker use http://localhost:11434
OLLAMA_URL=http://host.docker.internal:11434

# --- request/response log (one JSONL file per day in LOG_DIR; compose mounts /logs) ---
LOG_BODIES=true                     # false = metadata only, no prompt/response text in the file
LOG_RETENTION_DAYS=0                # delete daily files older than N days; 0 keeps everything

# --- router models ---
# Laya runs inside the router process as a Python package (from laya import Router).
LAYA_PRELOAD=0                      # 1 = load all three Laya checkpoints at startup
# Jev is a hosted API. kind: systemone (default) | ollama | openai_compat
JEV_KIND=systemone
JEV_URL=https://api.typesafe.ai/v1/systemone
JEV_MODEL=jev-latest
JEV_API_KEY=                        # your Jev API key (never commit .env)
ROUTER_TIMEOUT=15
